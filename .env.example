# Секрет для подписи JWT. В продакшене обязательно замените на случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Каталог для SQLite и загруженных файлов
DATA_DIR=/data

# Время жизни токена доступа, минут
ACCESS_TOKEN_TTL_MINUTES=720
